# Copy to .env and fill in. NEVER commit the real .env (it holds a live session cookie).
#
# Required — X session cookie for the account being posted to.
X_AUTH_TOKEN=

# Required only for RUN_MODE=persona (LLM content generation). Not needed for the arc.
ANTHROPIC_API_KEY=

# arc  = run the scripted mizukara launch sequence (default)
# persona = ongoing topic rotation + mention replies
RUN_MODE=arc

# Persona id for RUN_MODE=persona
PERSONA=mizukara

# Optional: arc start date (YYYY-MM-DD). Defaults to tomorrow if unset.
ARC_START_DATE=

# Optional: route the browser through a proxy for a residential exit IP.
# Use a STICKY / static residential (ISP) endpoint, not rotating.
# Format: http://user:pass@host:port
PROXY_URL=
